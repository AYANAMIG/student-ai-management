<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.demo.mapper.LogMapper">

    <select id="findAll" resultType="org.example.demo.model.Log">
        SELECT * FROM log ORDER BY time DESC
    </select>

    <insert id="insert" parameterType="org.example.demo.model.Log">
        INSERT INTO log (operator, type, time)
        VALUES (#{operator}, #{type}, NOW())
    </insert>
</mapper>