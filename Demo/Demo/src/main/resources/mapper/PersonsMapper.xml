<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.demo.mapper.PersonsMapper">
    <select id="findpersonByUserName" resultType="org.example.demo.model.persons">
        SELECT * FROM persons WHERE uname=#{uname} AND upwd=#{upwd}
    </select>
</mapper>